// lib/mock-db.ts
function simulateReturn(
  assetId: string,
  months: number,
  principal: number
): {
  ok: boolean
  series: { t: number; v: number }[]
  expectedFinal: number
  expectedYield: number
  monthlyRate: number
  maturity: number
  message?: string
} {
  const assets = listSimAssets()
  const asset = assets.find((a) => a.id === assetId)
  const now = Date.now()
  if (!asset) {
    return { ok: false, series: [], expectedFinal: 0, expectedYield: 0, monthlyRate: 0, maturity: now, message: "Ativo inexistente" }
  }
  if (!Number.isFinite(months) || months <= 0) {
    return { ok: false, series: [], expectedFinal: 0, expectedYield: 0, monthlyRate: asset.monthlyRate, maturity: now, message: "Prazo inválido" }
  }
  if (!Number.isFinite(principal) || principal <= 0) {
    return { ok: false, series: [], expectedFinal: 0, expectedYield: 0, monthlyRate: asset.monthlyRate, maturity: now, message: "Valor inválido" }
  }

  let value = principal
  const start = now
  const maturity = start + months * MS_MONTH
  const series: { t: number; v: number }[] = [{ t: start, v: value }]

  for (let m = 1; m <= months; m++) {
    let rate = asset.monthlyRate + monthVolatility(asset.id, m, asset.risk)
    if (asset.risk === "Variável") {
      rate += variableAdjustment(m)
    }
    value = value * (1 + rate)
    series.push({ t: start + m * MS_MONTH, v: value })
  }

  const expectedFinal = value
  const expectedYield = expectedFinal - principal

  return {
    ok: true,
    series,
    expectedFinal,
    expectedYield,
    monthlyRate: asset.monthlyRate,
    maturity,
  }
}

